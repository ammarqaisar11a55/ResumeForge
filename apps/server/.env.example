# Port the PDF service listens on.
PORT=4000

# Origins allowed to call the service from a browser (comma separated).
CORS_ORIGIN=http://localhost:5173

# Chrome or Chromium used for PDF export. Auto-detected when unset.
# CHROME_PATH=/usr/bin/google-chrome

# Required when running Chrome as root inside some containers.
# CHROME_NO_SANDBOX=true

# Serve the built web app (apps/web/dist) from this server in production.
# WEB_DIST=../web/dist
