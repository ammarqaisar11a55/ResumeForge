# Port the API listens on.
PORT=4000

# PostgreSQL connection string. When unset, an embedded PostgreSQL (PGlite)
# database is stored in DATA_DIR so the app works with no setup.
# DATABASE_URL=postgres://resumeforge:resumeforge@localhost:5432/resumeforge

# Directory for the embedded database. Use "memory" for a throwaway database.
DATA_DIR=.data

# Origins allowed to call the API from a browser (comma separated).
CORS_ORIGIN=http://localhost:5173

# Chrome or Chromium used for PDF export. Auto-detected when unset.
# CHROME_PATH=/usr/bin/google-chrome

# Required when running Chrome as root inside some containers.
# CHROME_NO_SANDBOX=true

# Serve the built web app (apps/web/dist) from this server in production.
# WEB_DIST=../web/dist
